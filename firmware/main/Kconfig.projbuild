menu "Firmware Integrity Checker"

    choice ALERT_TRANSPORT
        prompt "Alert transport (how ::STATUS::/::ALERT::/::REHASH:: frames leave the chip)"
        default ALERT_TRANSPORT_CONSOLE
        help
            CONSOLE: frames are written to the normal console (stdout/stdin).
            This is the SAME port you flash through, i.e. the board's USB
            connector, so a single USB cable is enough and the dashboard can
            use the COM/ttyUSB port that appears when you plug the board in.
            Works for UART, USB-Serial-JTAG and USB-CDC consoles. ESP_LOG
            lines share the stream; the dashboard parser ignores them.

            DEDICATED_UART: frames use a separate UART (pins below) and need
            an external USB-to-TTL adapter wired to those GPIOs.

        config ALERT_TRANSPORT_CONSOLE
            bool "Console (single USB cable - recommended)"
        config ALERT_TRANSPORT_UART
            bool "Dedicated UART (external USB-TTL adapter on GPIO pins)"
    endchoice

    config ENABLE_TAMPER_SIMULATION
        bool "Enable ::TAMPER:: debug command (simulated tamper event)"
        default n
        help
            Lets the dashboard's "Send ::TAMPER::" button inject one fake
            hash mismatch so you can test the CRITICAL alert path end to
            end. Never enable in production builds.

    config ALERT_UART_PORT_NUM
        int "UART port number for the dashboard alert channel"
        default 1
        range 0 2
        help
            Dedicated UART used to send "::ALERT:...::" packets to the
            desktop dashboard app. Must NOT be the same port as the
            ESP-IDF console (see CONFIG_ESP_CONSOLE_UART_NUM /
            CONFIG_ESP_CONSOLE_USB_CDC / CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG),
            or the two data streams will corrupt each other.
            Single-UART targets (e.g. ESP32-C3 in some board variants) may
            only expose UART0 and UART1 - check your board's datasheet.

    config ALERT_UART_TX_GPIO
        int "Alert UART TX GPIO"
        default 17
        help
            Pick a GPIO that is free on your specific board/chip. GPIO 17/18
            are safe defaults on most ESP32/ESP32-S2/ESP32-S3 devkits, but
            are NOT valid on every module (some are reserved for flash/PSRAM
            on -WROVER or octal-flash variants) and may not exist at all on
            smaller pin-count chips like the ESP32-C3/C6/H2. Check your
            target's pinout before flashing.

    config ALERT_UART_RX_GPIO
        int "Alert UART RX GPIO"
        default 18
        help
            See ALERT_UART_TX_GPIO. Set to -1 if this device only ever
            transmits alerts and never receives ::POLL::/::TAMPER:: commands.

    config ALERT_UART_BAUD_RATE
        int "Alert UART baud rate"
        default 115200

endmenu